.data
m1:      .asciiz "Thang "
m2:      .asciiz ": "
mt:      .asciiz "Tong: "
mm:      .asciiz "Thang cao nhat: "
lp:      .asciiz " ("
rp:      .asciiz ")"
nl:      .asciiz "\n"
reading: .word 1180, 1339, 1468, 1577, 1681, 1800, 1949
         .word 2123, 2337, 2586, 2850, 3089, 3283
usage:   .space 48
# Ma nguon 8 - dien nang tung thang
.text
.globl main
main:
  la   $s0, reading     # $s0 = dia chi nen reading
  la   $s1, usage       # $s1 = dia chi nen usage
  addi $s2, $zero, 0    # i = 0
  addi $s3, $zero, 12   # n = 12 thang
Loop:
  beq  $s2, $s3, Done   # thoat neu i == n
  sll  $t0, $s2, 2      # $t0 = 4 * i
  add  $t1, $t0, $s0    # $t1 = dia chi reading[i]
  lw   $t3, 0($t1)      # $t3 = reading[i]
  lw   $t4, 4($t1)      # $t4 = reading[i+1]
  sub  $t5, $t4, $t3    # $t5 = dien nang thang i+1
  add  $t2, $t0, $s1    # $t2 = dia chi usage[i]
  sw   $t5, 0($t2)      # usage[i] = $t5

  li   $v0, 4           # in "Thang "
  la   $a0, m1
  syscall
  li   $v0, 1           # in i+1
  addi $a0, $s2, 1
  syscall
  li   $v0, 4           # in ": "
  la   $a0, m2
  syscall
  li   $v0, 1           # in dien nang
  add  $a0, $t5, $zero
  syscall
  li   $v0, 4           # xuong dong
  la   $a0, nl
  syscall

  addi $s2, $s2, 1      # i = i + 1
  j    Loop
Done:
  li   $v0, 10
  syscall